{{ 'banner.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  ------------------------------------------------------------------
  Section: Product Grid
  ------------------------------------------------------------------
{%- endcomment -%}

{%- assign bundle_variant = section.settings.bundle_product.selected_or_first_available_variant -%}

<section
  class="product-grid"
  data-section-id="{{ section.id }}"
  data-section-type="product-grid"
  data-bundle-product-id="{{ section.settings.bundle_product.id }}"
  data-bundle-variant-id="{{ bundle_variant.id }}"
>
  {%- if section.settings.heading != blank -%}
    <h2 class="product-grid__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  <div class="product-grid__list">
    {%- for block in section.blocks -%}
      {%- assign product = block.settings.product -%}
      {%- if product != blank -%}
        <div class="product-grid__item" {{ block.shopify_attributes }}>
          <button
            type="button"
            class="product-grid__image-btn"
            data-gift-quick-view-trigger
            data-product-ref="{{ block.id }}"
            aria-haspopup="dialog"
            aria-controls="GiftGuideModal"
            aria-label="Quick view {{ product.title | escape }}"
          >
            {%- assign tile_image = block.settings.image | default: product.featured_image -%}
            {%- if tile_image != blank -%}
              {{
                tile_image
                | image_url: width: 800
                | image_tag:
                  loading: 'lazy',
                  alt: product.title,
                  class: 'product-grid__image',
                  sizes: '(min-width: 750px) 33vw, 50vw'
              }}
            {%- endif -%}
            <span class="product-grid__plus" aria-hidden="true">+</span>
          </button>

          {%- comment -%}
            JSON data island: gift-guide.js reads this via
            [data-gift-guide-product="{block.id}"] to populate the
            modal without a network request when the tile is clicked.
          {%- endcomment -%}
          {%- capture product_json -%}
            {
              "id": {{ product.id | json }},
              "title": {{ product.title | json }},
              "description": {{ product.description | strip_html | truncate: 200 | json }},
              "image": {{ product.featured_image | image_url: width: 800 | json }},
              "price": {{ product.price | money | json }},
              "options": {{ product.options_with_values | json }},
              "variants": [
                {%- for variant in product.variants -%}
                  {%- assign variant_image = variant.featured_image | default: product.featured_image -%}
                  {
                    "id": {{ variant.id | json }},
                    "price": {{ variant.price | money | json }},
                    "available": {{ variant.available | json }},
                    "option1": {{ variant.option1 | json }},
                    "option2": {{ variant.option2 | json }},
                    "option3": {{ variant.option3 | json }},
                    "image": {{ variant_image | image_url: width: 800 | json }}
                  }{%- unless forloop.last -%},{%- endunless -%}
                {%- endfor -%}
              ]
            }
          {%- endcapture -%}
          <script type="application/json" data-gift-guide-product="{{ block.id }}">
            {{ product_json }}
          </script>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{%- render 'gift-guide-modal' -%}
<script src="{{ 'gift-guide.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Product Grid",
  "tag": "section",
  "class": "section product-grid-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tisso vison in the wild"
    },
    {
      "type": "header",
      "content": "Gift with purchase rule"
    },
    {
      "type": "product",
      "id": "bundle_product",
      "label": "Bonus product",
      "info": "Automatically added to the cart whenever a variant with both a Black and a Medium option value is added (e.g. \"Soft Winter Jacket\")."
    }
  ],
  "blocks": [
    {
      "type": "product_block",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Tile image override",
          "info": "Optional. Falls back to the product's featured image."
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Product Grid",
      "blocks": [
        { "type": "product_block" },
        { "type": "product_block" },
        { "type": "product_block" },
        { "type": "product_block" },
        { "type": "product_block" },
        { "type": "product_block" }
      ]
    }
  ]
}
{% endschema %}
