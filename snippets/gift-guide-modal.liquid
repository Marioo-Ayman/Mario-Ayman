{%- comment -%}
  ------------------------------------------------------------------
  Snippet: gift-guide-modal
  Pixel-perfect quick view modal
  ------------------------------------------------------------------
{%- endcomment -%}

<div
  id="GiftGuideModal"
  class="gift-modal"
  hidden
  role="dialog"
  aria-modal="true"
  aria-labelledby="GiftGuideModalTitle"
>
  <div
    class="gift-modal__overlay"
    data-gift-modal-close
  ></div>

  <div
    class="gift-modal__dialog"
    tabindex="-1"
  >
    <button
      type="button"
      class="gift-modal__close"
      data-gift-modal-close
      aria-label="{{ 'actions.close' | t | default: 'Close' }}"
    >
      ✕
    </button>

    <div class="gift-modal__body">
      <!-- Product Image -->
      <div class="gift-modal__media">
        <img
          class="gift-modal__image"
          src=""
          alt=""
          width="400"
          height="500"
          loading="lazy"
        >
      </div>

      <!-- Product Information -->
      <div class="gift-modal__info">
        <h2
          class="gift-modal__title"
          id="GiftGuideModalTitle"
        ></h2>

        <p class="gift-modal__price"></p>

        <p class="gift-modal__description"></p>

        <!-- Dynamic Options -->
        <div class="gift-modal__options"></div>

        <!-- Add To Cart -->
        <button
          type="button"
          class="gift-modal__add-to-cart gift-animated-button gift-animated-button--dark"
          disabled
        >
          <span class="gift-animated-button__label">
            {{ 'products.product.add_to_cart' | t | default: 'ADD TO CART' }}
          </span>

          <span
            class="gift-animated-button__arrow"
            aria-hidden="true"
          >
            →
          </span>
        </button>

        <!-- Status Message -->
        <p
          class="gift-modal__message"
          role="status"
          aria-live="polite"
        ></p>
      </div>
    </div>
  </div>
</div>
